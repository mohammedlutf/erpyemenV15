 "html": "<!-- ERPNext v15 | Stock Reconciliation | Print Format -->\r\n{% if letter_head %}\r\n<div class=\"letter-head\">\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n<style>\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 11px;\r\n        color: #000;\r\n    }\r\n\r\n    .title {\r\n        text-align: center;\r\n        font-size: 16px;\r\n        font-weight: bold;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .header-table {\r\n        width: 100%;\r\n        margin-bottom: 12px;\r\n    }\r\n\r\n    .header-table td {\r\n        padding: 4px 6px;\r\n    }\r\n\r\n    table.items {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    table.items th,\r\n    table.items td {\r\n        border: 1px solid #000;\r\n        padding: 5px;\r\n    }\r\n\r\n    table.items th {\r\n        background-color: #f2f2f2;\r\n        text-align: center;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .text-right { text-align: right; }\r\n    .text-center { text-align: center; }\r\n    .bold { font-weight: bold; }\r\n\r\n    .totals-row td {\r\n        font-weight: bold;\r\n        background-color: #fafafa;\r\n    }\r\n</style>\r\n\r\n<div class=\"title\">Stock Reconciliation</div>\r\n\r\n<table class=\"header-table\">\r\n    <tr>\r\n        <td><b>Document No:</b> {{ doc.name }}</td>\r\n        <td><b>Posting Date:</b> {{ doc.posting_date }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td><b>Company:</b> {{ doc.company }}</td>\r\n        <td><b>Warehouse:</b> {{ doc.set_warehouse or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n{% set total_qty = 0 %}\r\n{% set total_amount = 0 %}\r\n{% set ns = namespace(total_qty=0, total_amount=0) %}\r\n<table class=\"items\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width:5%\">#</th>\r\n            <th style=\"width:15%\">Item Code</th>\r\n            <th style=\"width:30%\">Item Name</th>\r\n            <th style=\"width:10%\">UOM</th>\r\n            <th style=\"width:10%\">Qty</th>\r\n            <th style=\"width:15%\">Valuation Rate</th>\r\n            <th style=\"width:15%\">Amount</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.items %}\r\n\r\n        {% set total_qty = total_qty + row.qty %}\r\n        {% set total_amount = total_amount + row.amount %}\r\n        {% set ns.total_qty = ns.total_qty + row.qty %}\r\n        {% set ns.total_amount = ns.total_amount + row.amount %}\r\n        <tr>\r\n            <td class=\"text-center\">{{ loop.index }}</td>\r\n            <td>{{ row.item_code }}</td>\r\n            <td>{{ row.item_name }}</td>\r\n            <td class=\"text-center\">{{ row.stock_uom }}</td>\r\n            <td class=\"text-right\">{{ \"%.2f\" % row.qty }}</td>\r\n            <td class=\"text-right\">{{ row.get_formatted(\"valuation_rate\", doc) }}</td>\r\n            <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n\r\n    <tfoot>\r\n        <tr class=\"totals-row\">\r\n            <td colspan=\"4\" class=\"text-right\">Totals</td>\r\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(ns.total_qty) }}</td>\r\n            <td></td>\r\n            <td class=\"text-right\">{{ frappe.utils.fmt_money(ns.total_amount, currency=doc.currency)  }}</td>\r\n        </tr>\r\n    </tfoot>\r\n</table>\r\n\r\n<br>\r\n\r\n<table width=\"100%\">\r\n    <tr>\r\n        <td><b>Prepared By:</b> ____________________</td>\r\n        <td><b>Approved By:</b> ____________________</td>\r\n    </tr>\r\n</table>",
