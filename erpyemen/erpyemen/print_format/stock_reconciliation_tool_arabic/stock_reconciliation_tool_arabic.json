 "html": "<!-- ERPNext v15 | Stock Reconciliation | Modern Arabic Print Format -->\r\n{% if letter_head %}\r\n<div class=\"letter-head\">\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n<style>\r\n    body {\r\n        font-family: \"Cairo\", \"Segoe UI\", Arial, sans-serif;\r\n        font-size: 12px;\r\n        color: #222;\r\n        direction: rtl;\r\n    }\r\n\r\n    .title {\r\n        text-align: center;\r\n        font-size: 18px;\r\n        font-weight: 700;\r\n        margin-bottom: 14px;\r\n        color: #2c3e50;\r\n    }\r\n\r\n    .header-card {\r\n        border: 1px solid #ddd;\r\n        border-radius: 8px;\r\n        padding: 10px 14px;\r\n        margin-bottom: 14px;\r\n        background: #f9fbfd;\r\n    }\r\n\r\n    .header-table {\r\n        width: 100%;\r\n    }\r\n\r\n    .header-table td {\r\n        padding: 4px 6px;\r\n        font-weight: 500;\r\n    }\r\n\r\n    table.items {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        border-radius: 10px;\r\n        overflow: hidden;\r\n    }\r\n\r\n    table.items th,\r\n    table.items td {\r\n        padding: 8px 6px;\r\n        border-bottom: 1px solid #e0e0e0;\r\n    }\r\n\r\n    table.items th {\r\n        background: #34495e;\r\n        color: #fff;\r\n        text-align: center;\r\n        font-weight: 600;\r\n    }\r\n\r\n    table.items tr:nth-child(even) td {\r\n        background: #fafafa;\r\n    }\r\n\r\n    table.items tr:hover td {\r\n        background: #f1f6fb;\r\n    }\r\n\r\n    .text-right { text-align: right; }\r\n    .text-center { text-align: center; }\r\n    .bold { font-weight: 700; }\r\n\r\n    .totals-row td {\r\n        font-weight: 700;\r\n        background: #ecf3fa;\r\n        border-top: 2px solid #34495e;\r\n    }\r\n\r\n    .footer-sign {\r\n        margin-top: 20px;\r\n    }\r\n</style>\r\n\r\n<div class=\"title\">\u0645\u062d\u0636\u0631 \u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646</div>\r\n\r\n<div class=\"header-card\">\r\n    <table class=\"header-table\">\r\n        <tr>\r\n            <td>\u0631\u0642\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f: <b>{{ doc.name }}</b></td>\r\n            <td>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0642\u064a\u062f: <b>{{ doc.posting_date }}</b></td>\r\n        </tr>\r\n        <tr>\r\n            <td>\u0627\u0644\u0634\u0631\u0643\u0629: <b>{{ doc.company }}</b></td>\r\n            <td>\u0627\u0644\u0645\u062e\u0632\u0646: <b>{{ doc.set_warehouse or \"\" }}</b></td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n\r\n{% set ns = namespace(total_qty=0, total_amount=0) %}\r\n\r\n<table class=\"items\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width:5%\">\u0645</th>\r\n            <th style=\"width:15%\">\u0643\u0648\u062f \u0627\u0644\u0635\u0646\u0641</th>\r\n            <th style=\"width:30%\">\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</th>\r\n            <th style=\"width:10%\">\u0627\u0644\u0648\u062d\u062f\u0629</th>\r\n            <th style=\"width:10%\">\u0627\u0644\u0643\u0645\u064a\u0629</th>\r\n            <th style=\"width:15%\">\u0633\u0639\u0631 \u0627\u0644\u062a\u0642\u064a\u064a\u0645</th>\r\n            <th style=\"width:15%\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.items %}\r\n        {% set qty = row.qty or 0 %}\r\n        {% set amount = row.amount or (qty * (row.valuation_rate or 0)) %}\r\n        {% set ns.total_qty = ns.total_qty + qty %}\r\n        {% set ns.total_amount = ns.total_amount + amount %}\r\n        <tr>\r\n            <td class=\"text-center\">{{ loop.index }}</td>\r\n            <td>{{ row.item_code }}</td>\r\n            <td>{{ row.item_name }}</td>\r\n            <td class=\"text-center\">{{ row.stock_uom }}</td>\r\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(qty) }}</td>\r\n            <td class=\"text-right\">{{ row.get_formatted(\"valuation_rate\", doc) }}</td>\r\n            <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n\r\n    <tfoot>\r\n        <tr class=\"totals-row\">\r\n            <td colspan=\"4\" class=\"text-right\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td>\r\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(ns.total_qty) }}</td>\r\n            <td></td>\r\n            <td class=\"text-right\">\r\n                {{ frappe.utils.fmt_money(ns.total_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n    </tfoot>\r\n</table>\r\n\r\n<div class=\"footer-sign\">\r\n    <table width=\"100%\">\r\n        <tr>\r\n            <td>\u0623\u064f\u0639\u0650\u062f\u0651\u064e \u0628\u0648\u0627\u0633\u0637\u0629: ____________________</td>\r\n            <td>\u0627\u0639\u062a\u0645\u0627\u062f: ____________________</td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n",
