 "html": "{{ letter_head }}\r\n\r\n<!-- Customer & Quotation Info -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>To:</strong> {{ doc.customer_name }} <br>\r\n       Field Head of Finance <br>\r\n        P.O. Box 481 <br>\r\n        CPU-Marib, Republic of Yemen    <br>\r\n      <strong>Tel:</strong> 009676 330208  <strong>Extn:</strong> 4024\r\n                               \r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong>Date:</strong> {{ frappe.utils.formatdate(doc.transaction_date) }} <br>\r\n      <strong>PO NO. :</strong> {{ doc.po_no }} <br>\r\n      <strong>Currency:</strong> {{ doc.currency }}\r\n    </td>\r\n  </tr>\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>RFQ NO.:</strong> {{ frappe.db.get_value(\"Order Track\",doc.order_track,\"rfq_no\") or \"N/A\" }} <br>\r\n      <!--<strong>PR NO.:</strong> {{ frappe.db.get_value(\"Order Track\",doc.order_track,\"pr_ref_no\") or \"N/A\" }}  <br>-->\r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong> DELIVERY LOCATION :</strong> {{ doc.shipping_address_name or \"N/A\"}} <br>\r\n      <!--<strong> DELIVERY TIME :</strong>  {{ doc.delivery_time or \"N/A\" }}  <br>-->\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- Items Table -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\r\n  <thead>\r\n    <tr style=\"background-color: red; color: #fff; text-align: left;\">\r\n        <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Sr</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Item Code</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">Description</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">MFG. Name</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">PART NO.</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Qty</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Rate</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Amount</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for i,row in enumerate(doc.items,start=1) %}\r\n    <tr>\r\n        <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ i }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ row.item_code }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ row.description }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Item\",row.item_code,\"manufacturer_name\") or \"N/A\" }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Item\",row.item_code,\"mfr_part_number\") or \"N/A\" }}</td>\r\n\r\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ row.qty }} {{ row.uom }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ row.rate }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ row.amount }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<!-- Totals -->\r\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px;\">\r\n  <tr>\r\n    <td style=\"width: 70%;\"></td> <!-- empty space -->\r\n    <td style=\"width: 30%; text-align: right; padding: 8px; font-weight: bold; color: red; border-top: 1px solid red;\">\r\n      Total: {{ doc.base_grand_total }} {{ doc.currency }}\r\n    </td>\r\n  </tr>\r\n</table>\r\n<br><br>\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 30%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>Comments or Special Instructions</strong> \r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 70%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong>\r\n          {{ doc.terms }}\r\n      </strong>\r\n    </td>\r\n  </tr>\r\n  \r\n</table>\r\n{{ footer }}\r\n",
