 "font_size": 14,
 "html": "{{ letter_head }}\r\n\r\n{% set a = frappe.get_doc(\"Delivery Note\",doc.delivery_note) %}\r\n<!-- Customer & Quotation Info -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>Customer :</strong> {{ a.customer }} <br>\r\n      <strong>For :</strong> Safe Way Express Cargo <br>\r\n        FZS5BA04, SOUTH ZONE JAFZA, Near gate 14, Dubai, UAE <br>\r\n                               \r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong>Date:</strong> {{ a.posting_date }} <br>\r\n      <strong>PO NO. :</strong> {{ a.po_no or \"\"}} <br>\r\n    </td>\r\n  </tr>\r\n  \r\n</table>\r\n\r\n<!-- Items Table -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\r\n  <thead>\r\n    <tr style=\"background-color: red; color: #fff; text-align: left;\">\r\n    <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Sr</th>    \r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Item Code</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">Description</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">MFG. Name</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">PART NO.</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd;color: #ffffff !important;\">HS CODE</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Qty</th>\r\n      \r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for i,row in enumerate(doc.items,start=1) %}\r\n    <tr>\r\n    <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ i }}</td>    \r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ row.item_code }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ row.description }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Item\",row.item_code,\"manufacturer_name\") or \"N/A\" }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Item\",row.item_code,\"mfr_part_number\") or \"N/A\" }}</td>\r\n      <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ row.dn_detail }}</td>\r\n\r\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ row.qty }} {{ row.stock_uom }}</td>\r\n      \r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px;\">\r\n  <tr>\r\n    <td style=\"width: 70%;\"></td> <!-- empty space -->\r\n    <td style=\"width: 30%; text-align: right; padding: 8px; font-weight: bold; color: red; border-top: 1px solid red;\">\r\n      Total Package: {{ doc.to_case_no }}  <br>\r\n      Weight: {{ doc.gross_weight_pkg }} Kg\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<br><br>\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 30%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>Comments </strong> \r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 70%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong>\r\n         {{ a.terms }}\r\n      </strong>\r\n    </td>\r\n  </tr>\r\n  \r\n</table>\r\n\r\n",
