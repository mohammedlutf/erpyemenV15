 "font_size": 14,
 "html": "{{ letter_head }}\r\n\r\n<script>\r\n\r\ndocument.title = \"RFQ#{{ frappe.db.get_value(\"Order Track\",doc.order_track,\"rfq_no\") or \"N/A\" }}_(AUTECH_OFFER)\";\r\n\r\n</script>\r\n<!-- Customer & Quotation Info -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>To:</strong> {{ doc.contact_display or \"\" }} <br>\r\n      <strong>Company:</strong> {{ doc.customer_name }} <br>\r\n      <strong>Address:</strong>{{ doc.address_displays or \"P.O.Box 481 - Republic of Yemen\" }}   <br>\r\n      <!--<strong>Tel:</strong> {{ doc.contact_mobile or \"N/A\" }}-->\r\n                               \r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong>Date:</strong> {{ frappe.utils.formatdate(doc.transaction_date) }} <br>\r\n      <strong>Valid Till:</strong> {{ doc.valid_till }} <br>\r\n      <strong>Currency:</strong> {{ doc.currency }}\r\n    </td>\r\n  </tr>\r\n  <tr>\r\n    <!-- Left Column: Customer Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>RFQ NO.:</strong> {{ frappe.db.get_value(\"Order Track\",doc.order_track,\"rfq_no\") or \"N/A\" }} <br>\r\n      <strong>PR NO.:</strong> {{ frappe.db.get_value(\"Order Track\",doc.order_track,\"pr_ref_no\") or \"N/A\" }}  <br>\r\n    </td>\r\n\r\n    <!-- Right Column: Quotation Info -->\r\n    <td style=\"width: 50%; vertical-align: top; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      <strong> Delivery Terms :</strong> {{doc.incoterm }}-{{doc.named_place  or frappe.db.get_value(\"Address\",doc.shipping_address_name,\"address_title\") or doc.shipping_address_name or \"N/A\"}} <br>\r\n      <strong> Delivery Time :</strong>  {{ doc.delivery_time or \"N/A\" }}  <br>\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- Items Table (group by item_code, show numbered options) -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\r\n  <thead>\r\n    <tr style=\"background-color: red; color: #fff; text-align: left;\">\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Sr</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Item Code</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">Description</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">MFG. Name</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; color: #ffffff !important;\">PART NO.</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Qty</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Rate</th>\r\n      <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: #ffffff !important;\">Amount</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {# build ordered list of unique item_codes #}\r\n    {% set item_codes = [] %}\r\n    {% for r in doc.items %}\r\n      {% if r.item_code not in item_codes %}\r\n        {% set _ = item_codes.append(r.item_code) %}\r\n      {% endif %}\r\n    {% endfor %}\r\n\r\n    {% set sr = [1] %}\r\n    {% for code in item_codes %}\r\n      {# collect all rows with this item_code #}\r\n      {% set rows = [] %}\r\n      {% for r in doc.items %}\r\n        {% if r.item_code == code %}\r\n          {% set _ = rows.append(r) %}\r\n        {% endif %}\r\n      {% endfor %}\r\n\r\n      {% if rows|length > 0 %}\r\n        {% set main = rows[0] %}\r\n        <!-- Main Item -->\r\n        <tr style=\"background-color:#f9f9f9; font-weight:bold;\">\r\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ sr[0] }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ main.item_code }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ main.description or main.item_name }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ main.manufacturer_name or frappe.db.get_value(\"Item\", main.item_code, \"manufacturer_name\") or \"N/A\" }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Item\", main.item_code, \"mfr_part_number\") or \"N/A\" }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ main.qty }} {{ main.uom }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.0f}\".format(main.rate) }}</td>\r\n          <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.0f}\".format(main.amount) }}</td>\r\n        </tr>\r\n        {% set _ = sr.append(sr.pop() + 1) %}\r\n\r\n        {# Options #}\r\n        {% for opt in rows %}\r\n          {% if not loop.first %}\r\n            <tr>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd;\"></td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd;\"></td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd;\"><span style=\"font-weight: bold; font-size: 13px;\">Option {{ loop.index }}: </span><br> {{ opt.description or opt.item_name }}</td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ opt.manufacturer_name or frappe.db.get_value(\"Item\", opt.item_code, \"manufacturer_name\") or \"N/A\" }}</td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd;\">{{opt.mfr_part_number or frappe.db.get_value(\"Item\", opt.item_code, \"mfr_part_number\") or \"N/A\" }}</td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ opt.qty }} {{ opt.uom }}</td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.0f}\".format(opt.rate) }}</td>\r\n              <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.0f}\".format(opt.amount) }}</td>\r\n            </tr>\r\n          {% endif %}\r\n        {% endfor %}\r\n      {% endif %}\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<!-- Totals -->\r\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px;\">\r\n  <tr>\r\n    <td style=\"width: 70%;\"></td>\r\n    <td style=\"width: 30%; text-align: right; padding: 8px; font-weight: bold; color: red; border-top: 1px solid red;\">\r\n      <!--Total: {{ \"{:,.0f}\".format(doc.base_grand_total) }} {{ doc.currency }}-->\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n\r\n<br><br>\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; border: 1px solid #ddd;\">\r\n  \r\n  <!-- Row 1: Header -->\r\n  <tr>\r\n    <td style=\"width: 100%; padding: 10px; border: 1px solid #ddd;\">\r\n      <strong>Terms & Conditions: </strong>\r\n    </td>\r\n  </tr>\r\n\r\n  <!-- Row 2: Terms -->\r\n  <tr>\r\n    <td style=\"width: 100%; padding: 10px; border: 1px solid #ddd; text-align: left;\">\r\n      {{ doc.terms }}\r\n    </td>\r\n  </tr>\r\n\r\n</table>\r\n{{ footer }}\r\n",
